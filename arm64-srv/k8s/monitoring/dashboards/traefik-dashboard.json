{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Production-grade dual Traefik ingress dashboard, integrating Prometheus metrics and Loki parsed JSON access logs with advanced analytics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Ingress Controller High Level KPIs",
      "type": "row"
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Total Request Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_title"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\", code=~\"[23]..\"}[2m])) / sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m])) * 100",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95.0 },
              { "color": "green", "value": 99.0 }
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_title"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Client Errors (4xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\", code=~\"4..\"}[2m])) / sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m])) * 100",
          "legendFormat": "4xx %",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 5.0 }
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_title"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Server Errors (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\", code=~\"5..\"}[2m])) / sum(rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m])) * 100) or vector(0)",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_title"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "Traffic Latency and HTTP Status Analysis",
      "type": "row"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingress Latency (Percentiles)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_entrypoint_request_duration_seconds_bucket{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m]))) * 1000",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(traefik_entrypoint_request_duration_seconds_bucket{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m]))) * 1000",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_entrypoint_request_duration_seconds_bucket{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m]))) * 1000",
          "legendFormat": "p95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_entrypoint_request_duration_seconds_bucket{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m]))) * 1000",
          "legendFormat": "p99",
          "refId": "D"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Response Codes by Status",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{job=~\"$job\", entrypoint=~\"$entrypoint\"}[2m]))",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 102,
      "title": "Router & Service Analysis (Public vs Private)",
      "type": "row"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Traffic volume by Ingress Router",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (router) (rate(traefik_router_requests_total{job=~\"$job\"}[2m]))",
          "legendFormat": "{{router}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Traffic volume by Backend Kubernetes Service",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(traefik_service_requests_total{job=~\"$job\"}[2m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 105,
      "title": "Loki LogQL Analytical Traffic Insights (JSON-Parsed Access Logs)",
      "type": "row"
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Top 10 Client Host IPs (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (ClientHost) (count_over_time({namespace=\"ingress\", container=\"traefik\"} | json [5m])))",
          "legendFormat": "{{ClientHost}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Top 10 Requested Domain Hosts (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (RequestHost) (count_over_time({namespace=\"ingress\", container=\"traefik\"} | json [5m])))",
          "legendFormat": "{{RequestHost}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 15,
      "type": "barchart",
      "title": "Top 10 Requested Paths (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (RequestPath) (count_over_time({namespace=\"ingress\", container=\"traefik\"} | json [5m])))",
          "legendFormat": "{{RequestPath}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Error Status Codes (>=400) by Kubernetes Ingress (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "targets": [
        {
          "expr": "sum by (KubernetesIngressName, DownstreamStatus) (count_over_time({namespace=\"ingress\", container=\"traefik\"} | json | DownstreamStatus >= 400 [5m]))",
          "legendFormat": "Errors",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "options": {
        "footer": {
          "enablePagination": true
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "id": 103,
      "title": "Proxy Scaling & Core System Metrics",
      "type": "row"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active Open TCP Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(traefik_open_connections{job=~\"$job\"})",
          "legendFormat": "Active Connections",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Proxy Engine Goroutines",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "go_goroutines{job=~\"$job\"}",
          "legendFormat": "Goroutines ({{instance}})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Proxy Heap Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{job=~\"$job\"}",
          "legendFormat": "Allocated Bytes ({{instance}})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "decbytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "id": 104,
      "title": "Loki Correlated Real-time Access Logs (JSON-Parsed)",
      "type": "row"
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Correlated Access Logs (Filterable by Ingress/Router)",
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "targets": [
        {
          "expr": "{namespace=\"ingress\", container=\"traefik\"} | json",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ],
